--- /dev/null
+++ b/test/harness/audited_asset_server.dart
@@ -0,0 +1,44 @@
+// Hybrid isolate asset server that reports what the browser asks for and can
+// hide files.
+//
+// Same job as asset_server.dart. The spawn message is a list of paths (as
+// requested, e.g. `web_assets/pdf_oxide_asyncify_bg.wasm`) the server answers
+// with 404. The channel carries the port first, then one string per request,
+// `METHOD path`, in the order the server saw them.
+//
+//   final channel = spawnHybridUri('/test/harness/audited_asset_server.dart',
+//       message: ['web_assets/pdf_oxide_asyncify_bg.wasm'], stayAlive: true);
+//   final events = StreamQueue(channel.stream);
+//   final port = (await events.next as double).toInt();
+
+// io-exempt: hybrid-isolate harness; runs an HttpServer so chrome tests can
+// fetch web_assets/.
+import 'dart:io';
+
+import 'package:shelf/shelf.dart';
+import 'package:shelf/shelf_io.dart' as io;
+import 'package:shelf_static/shelf_static.dart';
+import 'package:stream_channel/stream_channel.dart';
+
+const _headers = {'Access-Control-Allow-Origin': '*'};
+
+Future<void> hybridMain(StreamChannel<Object?> channel, Object? message) async {
+  final hidden = {for (final path in (message as List?) ?? const []) '$path'};
+  final server = await HttpServer.bind('localhost', 0);
+  final files = createStaticHandler('.');
+  io.serveRequests(server, (Request request) async {
+    if (request.method == 'OPTIONS') {
+      return Response.ok(null, headers: _headers);
+    }
+    channel.sink.add('${request.method} ${request.url.path}');
+    if (hidden.contains(request.url.path)) {
+      return Response.notFound('hidden', headers: _headers);
+    }
+    return (await files(request)).change(headers: _headers);
+  });
+  channel.sink.add(server.port);
+  await channel.stream
+      .listen(null)
+      .asFuture<void>()
+      .then<void>((_) => server.close());
+}
diff --git a/test/harness/audited_server.dart b/test/harness/audited_server.dart
new file mode 100644
index 0000000..0b84145
--- /dev/null
+++ b/test/harness/audited_server.dart
@@ -0,0 +1,52 @@
+// A running audited_asset_server.dart, from the test's side: its port and the
+// requests it has seen.
+
+import 'dart:async';
+
+import 'package:stream_channel/stream_channel.dart';
+import 'package:test/test.dart';
+
+/// A server that hides some paths and lists every request it gets.
+class AuditedServer {
+  AuditedServer._(this.port, this._events, this.requests);
+
+  final int port;
+  final StreamIterator<Object?> _events;
+  final List<String> requests;
+
+  static Future<AuditedServer> start(List<String> hide) async {
+    final StreamChannel<Object?> channel = spawnHybridUri(
+      '/test/harness/audited_asset_server.dart',
+      message: hide,
+      stayAlive: true,
+    );
+    final events = StreamIterator(channel.stream);
+    await events.moveNext();
+    final audit = AuditedServer._(
+      (events.current as double).toInt(),
+      events,
+      [],
+    );
+    unawaited(audit._collect());
+    return audit;
+  }
+
+  Future<void> _collect() async {
+    while (await _events.moveNext()) {
+      requests.add(_events.current! as String);
+    }
+  }
+
+  String get workerUrl =>
+      'http://localhost:$port/web_assets/executor_worker.js';
+
+  /// The requests whose path ends in `file`, as `METHOD path`.
+  List<String> asked(String file) => [
+    for (final r in requests)
+      if (r.endsWith(file)) r,
+  ];
+
+  /// Lets requests the server has sent but this side has not read yet arrive.
+  Future<void> settle() =>
+      Future<void>.delayed(const Duration(milliseconds: 300));
+}
diff --git a/test/hook/asyncify_list_test.dart b/test/hook/asyncify_list_test.dart
new file mode 100644
index 0000000..108cf0a
--- /dev/null
+++ b/test/hook/asyncify_list_test.dart
@@ -0,0 +1,135 @@
+// The Asyncify instrumentation list and its wall. A hand-assembled module
+// stands in for the engine: two pausing imports, a direct caller, a function
+// that reaches the import only through a table, and functions that never do.
+
+@TestOn('vm')
+library;
+
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:pdf_manipulator/src/hook/asyncify_list.dart';
+import 'package:test/test.dart';
+
+List<int> _u32(int v) {
+  final out = <int>[];
+  do {
+    var b = v & 0x7f;
+    v >>= 7;
+    if (v != 0) b |= 0x80;
+    out.add(b);
+  } while (v != 0);
+  return out;
+}
+
+List<int> _name(String s) => [..._u32(s.length), ...utf8.encode(s)];
+
+List<int> _section(int id, List<int> body) => [
+  id,
+  ..._u32(body.length),
+  ...body,
+];
+
+List<int> _body(List<int> code) => [..._u32(code.length + 1), 0, ...code];
+
+/// Function indices: 0 and 1 are the imports; 2 calls import 0; 3 calls 2;
+/// 4 calls index 5-or-7's type through the table; 5 (in the table) calls 2;
+/// 6 calls nothing; 7 (in the table) calls nothing. The list names a defined
+/// function by its index among the defined ones (index minus the 2 imports).
+Uint8List _module({List<int>? extra}) {
+  const t0 = [0x60, 0, 0];
+  const t1 = [0x60, 1, 0x7f, 0];
+  return Uint8List.fromList([
+    0,
+    0x61,
+    0x73,
+    0x6d,
+    1,
+    0,
+    0,
+    0,
+    ..._section(1, [2, ...t0, ...t1]),
+    ..._section(2, [
+      2,
+      ..._name('./g.js'),
+      ..._name('__wbg_host_read_at_1'),
+      0,
+      0,
+      ..._name('./g.js'),
+      ..._name('__wbg_host_write_chunk_2'),
+      0,
+      0,
+    ]),
+    ..._section(3, [6, 0, 0, 0, 1, 0, 1]),
+    ..._section(4, [1, 0x70, 0, 2]),
+    ..._section(9, [1, 0, 0x41, 0, 0x0b, 2, 5, 7]),
+    ..._section(10, [
+      6,
+      ..._body([0x10, 0, 0x0b]),
+      ..._body([0x10, 2, 0x0b]),
+      ..._body([0x41, 0, 0x41, 0, 0x11, 1, 0, 0x0b]),
+      ..._body([0x10, 2, 0x0b]),
+      ..._body(extra ?? [0x0b]),
+      ..._body([0x0b]),
+    ]),
+  ]);
+}
+
+void main() {
+  group('asyncify list', () {
+    test('names the callers of the pausing imports, direct and by table', () {
+      expect(asyncifyList(_module()), '0,1,2,3');
+    });
+
+    test('a function that never reaches an import is not listed', () {
+      final listed = asyncifyList(_module()).split(',');
+      expect(listed, isNot(contains('4')));
+      expect(listed, isNot(contains('5')));
+    });
+
+    test('refuses a module whose table can change at run time', () {
+      // table.set in function 6 (index 6): i32.const 0; ref.null; table.set 0
+      final bytes = _module(extra: [0x41, 0, 0xd0, 0x70, 0x26, 0, 0x0b]);
+      expect(() => asyncifyList(bytes), throwsFormatException);
+    });
+  });
+
+  group('the wall', () {
+    test('passes the list the build computed', () {
+      final wasm = _module();
+      verifyAsyncifyList(wasm, asyncifyList(wasm));
+    });
+
+    test('passes a list with extra functions', () {
+      final wasm = _module();
+      verifyAsyncifyList(wasm, '${asyncifyList(wasm)},4');
+    });
+
+    test('fails when a function reachable from an import is missing', () {
+      final wasm = _module();
+      expect(
+        () => verifyAsyncifyList(wasm, '0,1,3'),
+        throwsA(
+          isA<StateError>().having((e) => e.message, 'message', contains('2')),
+        ),
+      );
+    });
+
+    test('fails on a list numbered with the imports counted', () {
+      // binaryen names a defined function by its index among the defined
+      // ones; the same functions numbered across the imports are the wrong ones.
+      expect(
+        () => verifyAsyncifyList(_module(), '2,3,4,5'),
+        throwsA(isA<StateError>()),
+      );
+    });
+
+    test('fails on a list from another build (stale)', () {
+      // A list made for a module without the table caller misses 2 and 3.
+      expect(
+        () => verifyAsyncifyList(_module(), '0,1'),
+        throwsA(isA<StateError>()),
+      );
+    });
+  });
+}
