new file mode 100644
index 0000000..9547dad
--- /dev/null
+++ b/tool/asyncify_list.dart
@@ -0,0 +1,532 @@
+// asyncify_list.dart — which functions of a built engine wasm can be on the
+// call stack while the module is paused at a host import, from the module's
+// own call graph.
+//
+//   dart --packages=.dart_tool/package_config.json tool/asyncify_list.dart \
+//        [--out <file>] [--pause <import-substring>]... <pdf_oxide_bg.wasm>
+//
+// binaryen's `--asyncify` instruments exactly the functions it is told to
+// (`--pass-arg=asyncify-onlylist@@<file>`); a function left out of that list
+// must never be on the stack at a pause. This tool computes the list that is
+// safe to give: the callers of the pausing imports, transitively, where a
+// `call_indirect` reaches every function of its signature that an element
+// segment or a `ref.func` names. It refuses a module whose tables could change
+// at run time (`table.set`, `table.init`, `table.copy`, `table.fill`, an
+// imported table), because the list would then be unsound.
+//
+// Prints the counts that decide whether the list is worth having: the direct
+// callers alone, the signature-resolved set, and for each signature the
+// functions it adds. `--out` writes the list in the form the pass reads: one
+// comma-separated line of function indices (the module has no name section,
+// and binaryen names an unnamed function by its index).
+//
+// `--pause` defaults to the two imports the executor worker suspends,
+// `host_read_at` and `host_write_chunk`. Run from the package root; `dart run`
+// would first run the package's native build hook, hence `dart --packages=`.
+
+import 'dart:io';
+import 'dart:typed_data';
+
+void main(List<String> args) {
+  final pause = <String>[];
+  String? out;
+  String? path;
+  for (var i = 0; i < args.length; i++) {
+    switch (args[i]) {
+      case '--out':
+        out = args[++i];
+      case '--pause':
+        pause.add(args[++i]);
+      default:
+        path = args[i];
+    }
+  }
+  if (path == null) {
+    stderr.writeln(
+      'usage: dart --packages=.dart_tool/package_config.json '
+      'tool/asyncify_list.dart [--out file] [--pause import]... <wasm>',
+    );
+    exit(2);
+  }
+  if (pause.isEmpty) pause.addAll(['host_read_at', 'host_write_chunk']);
+
+  final m = _Module.parse(File(path).readAsBytesSync());
+  final targets = {
+    for (var i = 0; i < m.importCount; i++)
+      if (pause.any(m.importNames[i].contains)) i,
+  };
+  if (targets.length != pause.length) {
+    stderr.writeln('pausing imports not found: ${m.importNames}');
+    exit(1);
+  }
+
+  final direct = m.ancestors(targets, indirect: false);
+  final all = m.ancestors(targets, indirect: true);
+  final bySig = m.signatureSteps(targets);
+  stdout
+    ..writeln(
+      'functions: ${m.funcType.length} (${m.importCount} imports), '
+      'address-taken: ${m.addressTaken.length}',
+    )
+    ..writeln('pausing imports: ${targets.map((t) => m.importNames[t])}')
+    ..writeln('callers by direct calls only: ${direct.length}')
+    ..writeln(
+      'callers with call_indirect resolved by signature: ${all.length} '
+      '(${(100 * all.length / m.funcType.length).toStringAsFixed(1)}% of the '
+      'module)',
+    )
+    ..writeln('signature resolution, in the order it grows the set:');
+  for (final step in bySig) {
+    stdout.writeln(
+      '  ${step.signature}  address-taken ancestors ${step.taken}, '
+      'call-site functions ${step.sites}, adds ${step.added}',
+    );
+  }
+  if (out != null) {
+    final list = [
+      for (final f in all.toList()..sort())
+        if (f >= m.importCount) f,
+    ];
+    File(out).writeAsStringSync(list.join(','));
+    stdout.writeln('wrote ${list.length} function indices to $out');
+  }
+}
+
+/// A function type as the bytes of its parameter and result lists.
+typedef _Sig = String;
+
+String _show(_Sig s) {
+  const names = {0x7f: 'i32', 0x7e: 'i64', 0x7d: 'f32', 0x7c: 'f64'};
+  final units = s.codeUnits;
+  final params = units[0];
+  String t(int v) => names[v] ?? '0x${v.toRadixString(16)}';
+  final p = [for (var i = 0; i < params; i++) t(units[1 + i])];
+  final r = [for (final v in units.sublist(2 + params)) t(v)];
+  return '(${p.join(',')})->(${r.join(',')})';
+}
+
+class _Step {
+  _Step(this.signature, this.taken, this.sites, this.added);
+  final String signature;
+  final int taken;
+  final int sites;
+  final int added;
+}
+
+class _Module {
+  _Module({
+    required this.importCount,
+    required this.importNames,
+    required this.callees,
+    required this.indirectTypes,
+    required this.funcType,
+    required this.addressTaken,
+  });
+
+  final int importCount;
+  final List<String> importNames;
+  final List<Set<int>> callees;
+  final List<Set<_Sig>> indirectTypes;
+  final List<_Sig> funcType;
+  final Set<int> addressTaken;
+
+  List<Set<int>> _callers({required bool indirect}) {
+    final callers = List.generate(funcType.length, (_) => <int>{});
+    final takenByType = <_Sig, List<int>>{};
+    for (final f in addressTaken) {
+      (takenByType[funcType[f]] ??= []).add(f);
+    }
+    for (var f = 0; f < funcType.length; f++) {
+      for (final c in callees[f]) {
+        callers[c].add(f);
+      }
+      if (!indirect) continue;
+      for (final t in indirectTypes[f]) {
+        for (final c in takenByType[t] ?? const <int>[]) {
+          callers[c].add(f);
+        }
+      }
+    }
+    return callers;
+  }
+
+  /// [targets] and every function that can be on the stack while one runs.
+  Set<int> ancestors(Set<int> targets, {required bool indirect}) {
+    final callers = _callers(indirect: indirect);
+    final seen = {...targets};
+    final work = [...targets];
+    while (work.isNotEmpty) {
+      for (final caller in callers[work.removeLast()]) {
+        if (seen.add(caller)) work.add(caller);
+      }
+    }
+    return seen;
+  }
+
+  /// The signatures through which the ancestor set grows, in the order they
+  /// are first reached from the direct callers, each with the functions it
+  /// added once the call sites of that signature are counted in.
+  List<_Step> signatureSteps(Set<int> targets) {
+    final callers = _callers(indirect: false);
+    final sitesOf = <_Sig, List<int>>{};
+    for (var f = 0; f < funcType.length; f++) {
+      for (final t in indirectTypes[f]) {
+        (sitesOf[t] ??= []).add(f);
+      }
+    }
+    final seen = {...targets};
+    void close(List<int> work) {
+      while (work.isNotEmpty) {
+        for (final caller in callers[work.removeLast()]) {
+          if (seen.add(caller)) work.add(caller);
+        }
+      }
+    }
+
+    close([...targets]);
+    final steps = <_Step>[];
+    final done = <_Sig>{};
+    while (true) {
+      final next = <_Sig>{
+        for (final f in seen)
+          if (addressTaken.contains(f)) funcType[f],
+      }..removeAll(done);
+      if (next.isEmpty) return steps;
+      for (final sig in next) {
+        done.add(sig);
+        final before = seen.length;
+        final taken = [
+          for (final f in seen)
+            if (addressTaken.contains(f) && funcType[f] == sig) f,
+        ].length;
+        final work = <int>[];
+        for (final f in sitesOf[sig] ?? const <int>[]) {
+          if (seen.add(f)) work.add(f);
+        }
+        close(work);
+        if (seen.length - before >= 100) {
+          steps.add(
+            _Step(
+              _show(sig),
+              taken,
+              sitesOf[sig]?.length ?? 0,
+              seen.length - before,
+            ),
+          );
+        }
+      }
+    }
+  }
+
+  static _Module parse(Uint8List bytes) {
+    final r = _Reader(bytes);
+    if (bytes.length < 8 || r.u32le() != 0x6d736100 || r.u32le() != 1) {
+      throw const FormatException('not a wasm binary');
+    }
+    final types = <_Sig>[];
+    final importNames = <String>[];
+    final importTypes = <int>[];
+    final localTypes = <int>[];
+    final taken = <int>{};
+    final bodies = <(int, int)>[];
+
+    while (!r.atEnd) {
+      final id = r.byte();
+      final end = r.u32() + r.pos;
+      switch (id) {
+        case 1:
+          for (var n = r.u32(); n > 0; n--) {
+            if (r.byte() != 0x60) {
+              throw const FormatException('unsupported type form');
+            }
+            final start = r.pos;
+            r.skip(r.u32());
+            r.skip(r.u32());
+            types.add(String.fromCharCodes(bytes.sublist(start, r.pos)));
+          }
+        case 2:
+          for (var n = r.u32(); n > 0; n--) {
+            final module = r.name();
+            final field = r.name();
+            switch (r.byte()) {
+              case 0:
+                importNames.add('$module.$field');
+                importTypes.add(r.u32());
+              case 1:
+                throw const FormatException('imported table');
+              case 2:
+                final flags = r.u32();
+                r.u32();
+                if (flags & 1 != 0) r.u32();
+              case 3:
+                r.skip(2);
+              default:
+                throw const FormatException('import kind');
+            }
+          }
+        case 3:
+          for (var n = r.u32(); n > 0; n--) {
+            localTypes.add(r.u32());
+          }
+        case 8:
+          taken.add(r.u32());
+        case 9:
+          _elements(r, taken);
+        case 10:
+          for (var n = r.u32(); n > 0; n--) {
+            final len = r.u32();
+            bodies.add((r.pos, r.pos + len));
+            r.skip(len);
+          }
+      }
+      r.pos = end;
+    }
+
+    final total = importNames.length + localTypes.length;
+    if (bodies.length != localTypes.length) {
+      throw const FormatException('function and code counts differ');
+    }
+    final callees = List.generate(total, (_) => <int>{});
+    final indirect = List.generate(total, (_) => <_Sig>{});
+    for (var i = 0; i < bodies.length; i++) {
+      final f = importNames.length + i;
+      _body(
+        _Reader(bytes)..pos = bodies[i].$1,
+        bodies[i].$2,
+        callees[f],
+        indirect[f],
+        types,
+        taken,
+      );
+    }
+    return _Module(
+      importCount: importNames.length,
+      importNames: importNames,
+      callees: callees,
+      indirectTypes: indirect,
+      funcType: [
+        for (final t in importTypes) types[t],
+        for (final t in localTypes) types[t],
+      ],
+      addressTaken: taken,
+    );
+  }
+
+  static void _elements(_Reader r, Set<int> taken) {
+    for (var n = r.u32(); n > 0; n--) {
+      final flags = r.u32();
+      final declared = flags & 1 != 0;
+      final explicitTable = flags & 2 != 0;
+      final exprs = flags & 4 != 0;
+      if (!declared) {
+        if (explicitTable) r.u32();
+        r.constExpr(taken);
+      }
+      if (declared || explicitTable) r.byte();
+      for (var k = r.u32(); k > 0; k--) {
+        if (exprs) {
+          r.constExpr(taken);
+        } else {
+          taken.add(r.u32());
+        }
+      }
+    }
+  }
+
+  /// One function body: local declarations, then instructions up to [end].
+  static void _body(
+    _Reader r,
+    int end,
+    Set<int> callees,
+    Set<_Sig> indirect,
+    List<_Sig> types,
+    Set<int> taken,
+  ) {
+    for (var n = r.u32(); n > 0; n--) {
+      r.u32();
+      r.byte();
+    }
+    while (r.pos < end) {
+      final op = r.byte();
+      switch (op) {
+        case 0x02 || 0x03 || 0x04:
+          r.blockType();
+        case 0x0c || 0x0d || 0x20 || 0x21 || 0x22 || 0x23 || 0x24:
+          r.u32();
+        case 0x25 || 0x26:
+          throw FormatException('table.get/set at ${r.pos}: tables can change');
+        case 0x0e:
+          for (var n = r.u32(); n >= 0; n--) {
+            r.u32();
+          }
+        case 0x10 || 0x12:
+          callees.add(r.u32());
+        case 0x11 || 0x13:
+          indirect.add(types[r.u32()]);
+          r.u32();
+        case 0x14 || 0x15:
+          throw const FormatException('call_ref is not resolved by this tool');
+        case 0x1c:
+          for (var n = r.u32(); n > 0; n--) {
+            r.byte();
+          }
+        case 0xd2:
+          taken.add(r.u32());
+        case 0xd0:
+          r.byte();
+        case 0xd5 || 0xd6:
+          r.u32();
+        case >= 0x28 && <= 0x3e:
+          r.u32();
+          r.u32();
+        case 0x3f || 0x40:
+          r.byte();
+        case 0x41 || 0x42:
+          r.sleb();
+        case 0x43:
+          r.skip(4);
+        case 0x44:
+          r.skip(8);
+        case 0xfc:
+          _prefixFc(r);
+        case 0xfd:
+          _prefixFd(r);
+        case 0xfe:
+          if (r.u32() == 3) {
+            r.byte();
+          } else {
+            r.u32();
+            r.u32();
+          }
+        case 0x00 ||
+            0x01 ||
+            0x05 ||
+            0x0b ||
+            0x0f ||
+            0x1a ||
+            0x1b ||
+            0xd1 ||
+            0xd4 ||
+            >= 0x45 && <= 0xc4:
+          break;
+        default:
+          throw FormatException('opcode 0x${op.toRadixString(16)}');
+      }
+    }
+  }
+
+  static void _prefixFc(_Reader r) {
+    final sub = r.u32();
+    switch (sub) {
+      case <= 7:
+        break;
+      case 8:
+        r.u32();
+        r.byte();
+      case 9 || 13:
+        r.u32();
+      case 10:
+        r.skip(2);
+      case 11:
+        r.byte();
+      case 12 || 14 || 15 || 16 || 17:
+        throw FormatException('0xfc $sub writes a table');
+      default:
+        throw FormatException('0xfc sub-opcode $sub');
+    }
+  }
+
+  static void _prefixFd(_Reader r) {
+    final sub = r.u32();
+    switch (sub) {
+      case <= 11 || 92 || 93:
+        r.u32();
+        r.u32();
+      case 12 || 13:
+        r.skip(16);
+      case >= 21 && <= 34:
+        r.byte();
+      case >= 84 && <= 91:
+        r.u32();
+        r.u32();
+        r.byte();
+      default:
+        break;
+    }
+  }
+}
+
+class _Reader {
+  _Reader(this.b);
+  final Uint8List b;
+  int pos = 0;
+
+  bool get atEnd => pos >= b.length;
+
+  int byte() => b[pos++];
+
+  void skip(int n) => pos += n;
+
+  int u32le() {
+    final v = ByteData.sublistView(b).getUint32(pos, Endian.little);
+    pos += 4;
+    return v;
+  }
+
+  int u32() {
+    var result = 0;
+    var shift = 0;
+    while (true) {
+      final x = b[pos++];
+      result |= (x & 0x7f) << shift;
+      if (x & 0x80 == 0) return result;
+      shift += 7;
+    }
+  }
+
+  void sleb() {
+    while (b[pos++] & 0x80 != 0) {}
+  }
+
+  void blockType() {
+    final x = b[pos];
+    if (x == 0x40 || x >= 0x6f && x <= 0x7f) {
+      pos++;
+    } else {
+      sleb();
+    }
+  }
+
+  String name() {
+    final n = u32();
+    final s = String.fromCharCodes(b.sublist(pos, pos + n));
+    pos += n;
+    return s;
+  }
+
+  /// A constant expression to its `end`; a `ref.func` names an
+  /// address-taken function.
+  void constExpr(Set<int> taken) {
+    while (true) {
+      final op = byte();
+      switch (op) {
+        case 0x0b:
+          return;
+        case 0xd2:
+          taken.add(u32());
+        case 0x41 || 0x42:
+          sleb();
+        case 0x23:
+          u32();
+        case 0xd0:
+          byte();
+        case 0x43:
+          skip(4);
+        case 0x44:
+          skip(8);
+        default:
+          throw FormatException('constant expression opcode $op');
+      }
+    }
+  }
+}
