+          final builder = await pdf.build();
+          final page = await builder.addPage(PdfPageSize.points(612, 792));
+          await page.text('Hello');
+          try {
+            await builder.save(sink);
+          } finally {
+            await builder.dispose();
+          }
+        },
+        'editor save': (pdf, sink) async {
