+      final next = await iter
+          .callMethod<JSPromise<JSObject>>('next'.toJS)
+          .toDart;
+      if ((next['done']! as JSBoolean).toDart) break;
+      count++;
+    }
+    return count;
+  } catch (_) {
+    return 0; // the worker never made its directory
+  }
