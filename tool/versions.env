# Single source of truth for pinned tool + dependency versions.
# Sourced by the scripts that need them — bump in ONE place, never inline.
# Plain `KEY="value"` so it's both shell-sourceable and trivially greppable.
#
#   source "$(dirname "$0")/versions.env"
#
# Each entry names the one file that consumes it.
#
# Every entry here is a pinned EXTERNAL tool/binary that the build downloads.
# Facts about the subject being built (the pdf_oxide crate, its base tag,
# its features) live in build.json instead.
#
# Who bumps what:
#   tool/ci/upgrade.sh (daily PR) — everything in this file: FVM_*, CHROME_*,
#       ACTIONLINT_VERSION, ZIZMOR_VERSION, BINARYEN_*, BORE_* (and, outside
#       this file, the Flutter SDK in .fvmrc).
#   Dependabot                 — pub deps + GitHub-action SHAs.

# binaryen / wasm-opt release (tool/compile_rust.sh).
BINARYEN_VERSION="version_130"

# fvm TOOL — downloaded + verified by .github/actions/capabilities/fvm and
# activated in create-release.yml. Pins the tool; the Flutter SDK itself is
# pinned separately in .fvmrc. Hashes self-computed from the release assets
# (leoafarias/fvm publishes no digests).
FVM_VERSION="4.1.2"
FVM_SHA256_LINUX_X64="12b0656688450972750cb714fc5e44ed2dbdd6b1c6813ba6ba6fb71841c17fe4"
FVM_SHA256_MACOS_ARM64="0b2a146986c51f06331f135f0bdf2a202eb57f55d7edd420c9078e8520e4c033"
FVM_SHA256_MACOS_X64="7bbfcb6883ea67ce532163704f5625eba7ecf340084be707cde71a28fefff1d8"
FVM_SHA256_WINDOWS_X64="9a18b4daac98dac3c3230ff67ccc644d5a7875d1fc09fb7d848cb2900b9478b8"

# actionlint — workflow linter run in the pr-lint.yml gate. Go-installed by
# this tag; Go verifies the module checksum, so no separate sha is tracked.
# Bumped by tool/ci/upgrade.sh.
ACTIONLINT_VERSION="1.7.12"

# zizmor — the security half of the pr-lint.yml gate, run via `pipx run`.
# pipx resolves the version from PyPI, so no separate sha is tracked.
# Bumped by tool/ci/upgrade.sh.
ZIZMOR_VERSION="1.26.1"

# pana — pub.dev's own analyzer, run by the `platforms` make target + CI job to
# gate that the package still resolves to all 6 pub.dev platforms. `dart pub
# global activate` resolves it from pub.dev (own integrity), so no sha is
# tracked. Bumped by tool/ci/upgrade.sh to pub.dev's LATEST: the gate must run
# the same pana pub.dev runs, or it drifts from the verdict it exists to predict.
PANA_VERSION="0.23.14"

# ── Pinned binary downloads (verified via tool/fetch_verified.sh) ──
# sha256 values are the upstream-published digest where one exists, else
# self-computed from the release asset. Bump alongside the version.

# binaryen / wasm-opt (tool/compile_rust.sh) — matches BINARYEN_VERSION.
BINARYEN_SHA256_LINUX_X64="0a18362361ad05465118cd8eeb72edaeec89de6894bc283576ef4e07aa3babcc"
BINARYEN_SHA256_MACOS_ARM64="79d3ab9f417d9e215f15f598f523d001a7d9ac1e59367e5c869fbdabd1cba72e"
BINARYEN_SHA256_WINDOWS_X64="cc09c874f4332d00aa32ab72745a9b98c9a172f795762f21d03e70638a3f7f4c"

# bore tunnel binary (.github/actions/debug-ssh). The action sources this file
# and builds its download URLs from BORE_VERSION, so the version lives here
# beside its hashes — one place for upgrade.sh to bump.
BORE_VERSION="v0.6.0"
BORE_SHA256_LINUX_X64="e484d1e3acba77169b773f31a5bfb34192d4b660f44a094a658a2522cd2270f7"
BORE_SHA256_MACOS_ARM64="65f43a67b90874700538bdb6064c5e92276e64dfba24f5cd72ef24a035eec3bc"
BORE_SHA256_WINDOWS_X64="01709c64fe2787cdc9a21d7030b0f08ad72dff0c36b7ecb72f4f667a55a34b4f"

# Chrome for Testing — chrome + chromedriver pinned per platform, so web
# tests run a verified, reproducible browser (.github/actions/capabilities/
# chrome). chrome-for-testing publishes no digests, so these are self-
# computed. upgrade.sh re-bumps on Chrome's ~4-week Stable cadence; the CDN
# prunes old versions, so the pin must be kept fresh or the download 404s.
CHROME_VERSION="150.0.7871.46"
CHROME_SHA256_LINUX_X64="ad115a7498a17f53f6ed0914458326c6516addc756224db14c32184a9b1ab078"
CHROME_SHA256_MACOS_ARM64="9b6c6fbbda6f2948c74425828bd18f0e59542fd2beb056697478c38a956d83cb"
CHROME_SHA256_WINDOWS_X64="2245f764e024897195bce1cf6ff16d60544351e4d1b68edb6956ea875ab8b929"
CHROMEDRIVER_SHA256_LINUX_X64="2bd858c27c5d913bc9574e4fb7196161acbefd7f911d9a4b1e01a4cd36095716"
CHROMEDRIVER_SHA256_MACOS_ARM64="fe616458e12b959c23565a4c3b057392e80f8bcb7b59410d9e493d6fcd864f1b"
CHROMEDRIVER_SHA256_WINDOWS_X64="934274246dfd0d1185f2b9acf5441bc6e72ee2deeafea6996f9a868be3089e13"
