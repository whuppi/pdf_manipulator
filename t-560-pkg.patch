+List<String> buildJsonPartProblems(
+  Directory dir,
+  BuildConstants constants, {
+  bool complete = false,
+}) {
+  final manifest = WasmManifest.load(dir);
+  final listed = {
+    for (final name in constants.webAssets.keys)
+      if (name.endsWith('.wasm')) name,
