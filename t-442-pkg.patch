+/// One page that draws a form of `lines` lines of text.
+pub fn text_form(lines: usize) -> Shell {
+    let mut shell = Shell::new();
+    let form = shell.pdf.add_stream(
+        &format!(
+            "/Type /XObject /Subtype /Form /BBox [0 0 612 792] /Resources << /Font << /F1 {} 0 R >> >>",
+            shell.font
+        ),
+        &text_lines(lines, 0),
+    );
+    shell.page((612, 792), b"q /Fm1 Do Q\n", &format!("/XObject << /Fm1 {form} 0 R >>"), "");
+    shell
+}
+
+/// One page of `n` save, identity transform and restore triples that then
+/// draws the image `/Im0`.
+pub fn long_page_image(n: usize) -> Shell {
+    let mut shell = Shell::new();
+    let id = shell.pdf.add_stream(
+        "/Type /XObject /Subtype /Image /Width 8 /Height 8 /ColorSpace /DeviceRGB /BitsPerComponent 8",
+        &rgb_image(8, 1),
+    );
+    let mut content = graphics(n);
+    content.extend_from_slice(b"q 24 0 0 24 20 20 cm /Im0 Do Q\n");
+    shell.page((612, 792), &content, &format!("/XObject << /Im0 {id} 0 R >>"), "");
+    shell
+}
+
+/// One page that draws a form of `n` save, identity transform and restore
+/// triples and one line of text: the form's operators are many, its text is not.
+pub fn graphics_text_form(n: usize) -> Shell {
+    let mut shell = Shell::new();
+    let mut content = graphics(n);
+    content.extend_from_slice(&text_lines(1, 0));
+    let form = shell.pdf.add_stream(
+        &format!(
+            "/Type /XObject /Subtype /Form /BBox [0 0 612 792] /Resources << /Font << /F1 {} 0 R >> >>",
+            shell.font
+        ),
+        &content,
+    );
+    shell.page((612, 792), b"q /Fm1 Do Q\n", &format!("/XObject << /Fm1 {form} 0 R >>"), "");
+    shell
+}
+
