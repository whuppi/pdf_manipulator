+    static CHUNKS: AtomicUsize = AtomicUsize::new(0);
+    static CHANNEL: AtomicPtr<u8> = AtomicPtr::new(std::ptr::null_mut());
+    static ONE_AT_A_TIME: Mutex<()> = Mutex::new(());
