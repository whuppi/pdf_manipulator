 #[wasm_bindgen]
 extern "C" {
-    fn host_read_at(source_index: u32, offset: u32, count: u32, buf_ptr: u32) -> i32;
+    fn host_read_at(source_index: u32, offset: f64, count: u32, buf_ptr: u32) -> i32;
 }
 
 /// Source reader backed by the `host_read_at` extern import.
@@ -75,11 +76,11 @@ impl Read for JsCallbackReader {
             }
             self.window_len = 0;
             let remaining = self.length - self.position;
-            let to_read = (remaining as usize).min(self.window.len());
+            let to_read = remaining.min(self.window.len() as u64) as usize;
 
             let n = host_read_at(
                 self.source_index,
-                self.position as u32,
+                self.position as f64,
                 to_read as u32,
                 self.window.as_mut_ptr() as u32,
             );
