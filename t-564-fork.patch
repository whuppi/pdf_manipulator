diff --git a/src/host/wasm/js_reader.rs b/src/host/wasm/js_reader.rs
index 1f5d1d3..ed4ed72 100644
--- a/src/host/wasm/js_reader.rs
+++ b/src/host/wasm/js_reader.rs
@@ -23,10 +23,11 @@ use wasm_bindgen::prelude::*;
 
 // Imported from the JS global scope (self.host_read_at in executor_worker.js).
 // Uses u32 for buf_ptr because wasm_bindgen doesn't support raw pointers.
-// WASM pointers are u32. Cast at the call site.
+// WASM pointers are u32. Cast at the call site. The offset is an f64, a JS
